<%
require "json"

strip_string = lambda do |value|
  value.is_a?(String) ? value.strip : value
end

to_bool = lambda do |value|
  case value
  when true, false
    value
  when String
    normalized = value.strip.downcase
    next true if %w[true 1 yes y on].include?(normalized)
    next false if %w[false 0 no n off].include?(normalized)
    value
  else
    value
  end
end

to_number = lambda do |value|
  case value
  when Integer, Float
    value
  when String
    stripped = value.strip
    next value if stripped.empty?
    next stripped.to_i if stripped.match?(/\A[+-]?\d+\z/)
    next stripped.to_f if stripped.match?(/\A[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?\z/)
    value
  else
    value
  end
end

to_number_or_bool = lambda do |value|
  numeric = to_number.call(value)
  return numeric unless numeric == value

  boolean = to_bool.call(value)
  return boolean unless boolean == value

  value
end

params = {
    "input": strip_string.call(context.input),
    "outdir": strip_string.call(context.outdir),
    "ref_fasta": strip_string.call(context.ref_fasta),
    "ref_gff": strip_string.call(context.ref_gff),
    "strategy": strip_string.call(context.strategy),
    "assembler": strip_string.call(context.assembler),
    "assembly_scaffolding_order": strip_string.call(context.assembly_scaffolding_order),
    "genome_size": strip_string.call(context.genome_size),
    "flye_mode": strip_string.call(context.flye_mode),
    "flye_args": strip_string.call(context.flye_args),
    "hifiasm_args": strip_string.call(context.hifiasm_args),
    "assembler_ont": strip_string.call(context.assembler_ont),
    "assembler_ont_args": strip_string.call(context.assembler_ont_args),
    "assembler_hifi": strip_string.call(context.assembler_hifi),
    "assembler_hifi_args": strip_string.call(context.assembler_hifi_args),
    "ontreads": strip_string.call(context.ontreads),
    "ont_collect": to_bool.call(strip_string.call(context.ont_collect)),
